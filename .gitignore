# Secrets
.env

# Virtual environments and tool caches
.venv/
.uv-cache/
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
coverage.xml
htmlcov/

# Local screening output. Anchored, so the committed evidence under
# alternatives/*/runs/ is not swept up with it.
/runs/
/output/
/tmp/

# Quarantine for files removed during the repo cleanup
.removed/

# Editor and OS
.DS_Store
.vscode/

# IU's own material. Not redistributed: see case-study/README.md
/case-study/*
!/case-study/README.md

# Regenerated by baseline.sh and the compile step, so not committed
alternate-options/*/runs/raw/
alternate-options/*/baseline/
alternate-options/*/runs/chroma/
alternate-options/*/runs/_smoke/
