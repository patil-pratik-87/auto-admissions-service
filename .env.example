# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# One variable sets the chat model everywhere: the service, option B, options C and D.
ADMISSIONS_OPENAI_MODEL=gpt-5.4-mini

# Optional per-component overrides, for running one arm on a different model.
# TWO_AGENTS_MODEL=
# AGENTIC_RAG_MODEL=
# CRITIC_MODEL=
# AGENTIC_RAG_EMBED_MODEL=text-embedding-3-large

# Tracing. Optional, and only used with the --trace flag or in the alternatives.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Separate LangSmith project per option, so traces are never mixed across architectures.
LANGSMITH_PROJECT=auto-admissions
# TWO_AGENTS_LANGSMITH_PROJECT=auto-admissions-prototype
# AGENTIC_RAG_LANGSMITH_PROJECT=auto-admissions-agentic-rag
# JUDGE_LANGSMITH_PROJECT=auto-admissions-judges
